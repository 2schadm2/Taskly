@page "/login"
@layout WebLayout
<div class="login-wrapper">
    <div class="login-card-wrapper">
        <div class="login-main-text-wrapper">
            <div class="login-text1">Taskly</div>
            <div class="login-text2">Stay organized. Stay reminded.</div>
        </div>

        <div class="login-input-text-wrapper">
            <div class="login-text3">Please login to your account</div>
            <div class="input-wrapper">
                <form>
                    <div class="input-group">
                        <input type="email" class="form-input" placeholder="Email">
                    </div>

                    <div class="input-group">
                        <input type="password" class="form-input" placeholder="Password">
                    </div>

                    <button class="form-button" type="submit">Login</button>
                </form>
            </div>

        </div>
    </div>
</div>