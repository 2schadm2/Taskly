@page "/downloads"
@layout WebLayout

<div class="download-wrapper">
    <div class="breadcrumb-wrapper">
        <div class="breadcrumb-previous-page" @onclick="GoToHome">Home</div>
        <div class="breadcrumb-slash">/</div>
        <div class="breadcrumb-current-page">Downloads</div>
    </div>
    <div class="download-content-wrapper">
        <div class="download-text1 gradient-text">Download taskly for your device</div>
        <div class="download-version-otherversion-wrapper">
            <div class="download-version-wrapper">
                <div class="download-versiontitle-status-wrapper">
                    <div class="download-versiontitle">
                        Taskly 7
                    </div>
                    <div class="download-version-status">
                        <div class="status">Current</div>
                    </div>
                </div>
                <div class="download-versionno-released-wrapper">
                    <div class="download-versionno">
                        v7.0.1
                    </div>
                    <div class="download-released">
                        Released: Jan 2026
                    </div>
                </div>
            </div>
            <div class="download-otherversion-wrapper" @onclick="GoToVersion">
                <div class="otherversion-wrapper">
                    <div class="download-otherversion">
                        Other Versions
                    </div>
                    <div class="download-otherversion-icon">
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>
                </div>             
            </div>
        </div>
        <div class="download-platform-wrapper">
            <div class="download-platform platform-windows">
                <div class="platform-header platform-windows-header">
                    <div class="platform-header-icon"><i class="fa-brands fa-windows"></i></div>
                    <div class="platform-header-text-wrapper">
                        <div class="platform-header-text1">Windows</div>
                        <div class="platform-header-text2">Version 7.0.1</div>
                    </div>
                </div>
                <div class="platform-body-wrapper">
                    <div class="platform-body-content">
                        <div class="platform-body-icon"><i class="fa-solid fa-download"></i></div>
                        <div class="platform-body-text">Download current version for windows</div>
                    </div>
                </div>
            </div>
            <div class="download-platform platform-android">
                <div class="platform-header platform-android-header">
                    <div class="platform-header-icon"><i class="fa-brands fa-android"></i></div>
                    <div class="platform-header-text-wrapper">
                        <div class="platform-header-text1">Android</div>
                        <div class="platform-header-text2">Version 7.0.1</div>
                    </div>
                </div>
                <div class="platform-body-wrapper">
                    <div class="platform-body-content">
                        <div class="platform-body-icon"><i class="fa-solid fa-download"></i></div>
                        <div class="platform-body-text">Download current version for android</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>